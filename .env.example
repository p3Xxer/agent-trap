# Copy to .env (never commit .env, never paste keys into chat).

# Where model calls go: nebius (hackathon requirement), nvidia, openrouter or ollama.
LLM_PROVIDER=nebius
NEBIUS_API_KEY=

# Money brakes. Checked BEFORE every call, assuming the worst case.
# One scan may not spend more than this:
MAX_USD_PER_CHECK=0.50
# Lifetime cap, remembered in .agenttrap/spend.json across runs. Keep it below your credits.
TOTAL_BUDGET_USD=20

# Ask Nemotron to skip long hidden "thinking" (cheaper, faster).
THINKING_OFF=1
# Reuse answers for identical requests (re-runs during development are free). 0 = always call.
CACHE=1
# Ask the host for guaranteed-valid JSON where we need JSON.
JSON_MODE=1

# Optional: look up flagged hosts on the web (agenttrap scan --lookup)
TAVILY_API_KEY=
