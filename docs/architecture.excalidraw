   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "When code steals: re-run the recorded\ncommands on copies of the repo with\nfiles, then lines, blanked out, several\nat once, until only the lines that\nstill cause the leak remain. No AI\ncalls.",
   "originalText": "When code steals: re-run the recorded\ncommands on copies of the repo with\nfiles, then lines, blanked out, several\nat once, until only the lines that\nstill cause the leak remain. No AI\ncalls.",
